# Production build — static assets served by Nginx. `Dockerfile` (no suffix)
# runs the Vite dev server instead and is what docker-compose.yml uses for
# local development; this one is what .github/workflows/docker.yml publishes
# to GHCR.
#
# VITE_API_URL is baked in at build time (Vite inlines env vars into the
# bundle — there's no reading it at container startup). If your API isn't at
# the default, build your own image with a different --build-arg VITE_API_URL
# rather than expecting to override it at `docker run` time.

FROM node:22-alpine AS build
WORKDIR /app
COPY package.json ./
RUN npm install
COPY . .
ARG VITE_API_URL=http://localhost:3000
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
