{
  "name": "@hookengine/webhooks",
  "version": "0.1.0",
  "description": "Sign and verify HookEngine webhook payloads — zero runtime dependencies, dual ESM/CJS.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./test-vectors.json": "./test-vectors.json"
  },
  "files": [
    "dist",
    "test-vectors.json"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/germankreibohmacotto/hookengine.git",
    "directory": "packages/webhooks"
  },
  "homepage": "https://github.com/germankreibohmacotto/hookengine/tree/main/packages/webhooks#readme",
  "keywords": [
    "webhooks",
    "hmac",
    "signature",
    "verify",
    "hookengine"
  ]
}
